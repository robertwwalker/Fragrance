{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"A Fragrance of the Day Selector\"\n",
        "format:\n",
        "  html:\n",
        "    page-layout: full\n",
        "    embed-resources: true\n",
        "---"
      ],
      "id": "e9a64a4b"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| output: asis\n",
        "#\n",
        "# DATA SOURCE: fragrances.csv (must live in the same folder as this .qmd)\n",
        "#\n",
        "# To update the collection:\n",
        "#   1. Edit fragrances.csv  (any spreadsheet app or text editor)\n",
        "#   2. Run:  quarto render index-weather.qmd\n",
        "#   The rebuilt HTML embeds the new data; no JS edits needed.\n",
        "#\n",
        "# Pipe-separated list columns: seasons, top_notes, heart_notes, base_notes\n",
        "#   e.g.  seasons = Fall|Winter      top_notes = Saffron|Rose|Bergamot\n",
        "#\n",
        "import csv, json, sys, os\n",
        "\n",
        "def _list(s):\n",
        "    if not s or not str(s).strip():\n",
        "        return []\n",
        "    return [x.strip() for x in str(s).split('|') if x.strip()]\n",
        "\n",
        "def _num(s, as_float=False):\n",
        "    if s is None or not str(s).strip():\n",
        "        return None\n",
        "    try:\n",
        "        return float(s) if as_float else int(float(s))\n",
        "    except (ValueError, TypeError):\n",
        "        return None\n",
        "\n",
        "fragrances = []\n",
        "try:\n",
        "    with open('fragrances.csv', newline='', encoding='utf-8') as fh:\n",
        "        for row in csv.DictReader(fh):\n",
        "            pyr = {\n",
        "                'top':   _list(row.get('top_notes',   '')),\n",
        "                'heart': _list(row.get('heart_notes', '')),\n",
        "                'base':  _list(row.get('base_notes',  ''))\n",
        "            }\n",
        "            f = {'name': row['name'].strip(), 'maker': row['maker'].strip()}\n",
        "            for field in ['concentration','tier','status','notes_raw','projection',\n",
        "                          'perfumer','scraped_url','url_status','time','fragram']:\n",
        "                f[field] = row.get(field, '').strip()\n",
        "            for field, af in [('longevity_hours', False), ('sillage', False),\n",
        "                               ('overall_rating',  True),  ('launch_year', False)]:\n",
        "                f[field] = _num(row.get(field, ''), af)\n",
        "            f['seasons'] = _list(row.get('seasons', ''))\n",
        "            f['pyramid'] = pyr\n",
        "            note = row.get('note', '').strip()\n",
        "            if note:\n",
        "                f['note'] = note\n",
        "            fragrances.append(f)\n",
        "except FileNotFoundError:\n",
        "    print('<script>console.error(\"[SOTD] fragrances.csv not found — '\n",
        "          'place it next to index-weather.qmd and re-render.\");</script>')\n",
        "\n",
        "print('<script>window.FRAGRANCES = ' +\n",
        "      json.dumps(fragrances, ensure_ascii=False) + ';</script>')\n",
        "# ── Wear log: committed rows, handed to JS so history survives a browser wipe ──\n",
        "wear_log = []\n",
        "try:\n",
        "    with open('wear_log.csv', newline='', encoding='utf-8') as fh:\n",
        "        for row in csv.DictReader(fh):\n",
        "            if not (row.get('name') or '').strip():\n",
        "                continue\n",
        "            w = {(k or '').strip(): (v or '').strip() for k, v in row.items() if k}\n",
        "            for fld in ['sprays', 'temp_f', 'longevity_obs_h', 'sillage_obs', 'ts']:\n",
        "                w[fld] = _num(w.get(fld, ''), False)\n",
        "            w['rating_today'] = _num(w.get('rating_today', ''), True)\n",
        "            wear_log.append(w)\n",
        "except FileNotFoundError:\n",
        "    pass   # first run: no log yet\n",
        "\n",
        "print('<script>window.WEAR_LOG = ' +\n",
        "      json.dumps(wear_log, ensure_ascii=False) + ';</script>')"
      ],
      "id": "f2088a88",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "```{=html}\n",
        "<style>\n",
        "@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');\n",
        "\n",
        ":root{\n",
        "  --bg1:#f6f1e7; --bg2:#ece3d2;\n",
        "  --card:#fffdf8; --ink:#2c2a26; --muted:#8a8378;\n",
        "  --accent:#a96f2f; --line:#e4dccd;\n",
        "  --shadow:0 20px 45px rgba(80,60,30,.12);\n",
        "}\n",
        "*{ box-sizing:border-box; }\n",
        "body{\n",
        "  font-family:'Inter','Segoe UI',system-ui,-apple-system,sans-serif;\n",
        "  background:linear-gradient(160deg,var(--bg1),var(--bg2));\n",
        "  color:var(--ink); margin:0;\n",
        "}\n",
        ".sotd-wrap{ max-width:900px; margin:0 auto; padding:1rem 1.25rem 4rem; }\n",
        ".hero{ text-align:center; padding:2.5rem 1rem .5rem; }\n",
        ".hero h1{ font-family:'Playfair Display',Georgia,serif; font-size:3rem; margin:0 0 .4rem; }\n",
        ".hero p{ color:var(--muted); font-size:1.05rem; margin:0; }\n",
        ".controls{ display:flex; flex-wrap:wrap; gap:1.25rem; justify-content:center; margin:1.5rem 0 .75rem; }\n",
        ".control-group{ display:flex; flex-direction:column; gap:.45rem; align-items:center; }\n",
        ".control-group .label{ font-size:.7rem; letter-spacing:.15em; text-transform:uppercase; color:var(--muted); font-weight:600; }\n",
        ".chips{ display:flex; flex-wrap:wrap; gap:.4rem; justify-content:center; }\n",
        ".chip{ border:1px solid var(--line); background:#fff; color:var(--ink); padding:.42rem .9rem; border-radius:999px; cursor:pointer; font-size:.85rem; transition:all .15s ease; }\n",
        ".chip:hover{ border-color:var(--accent); color:var(--accent); }\n",
        ".chip.active{ background:var(--accent); border-color:var(--accent); color:#fff; }\n",
        "\n",
        "/* ── Search ── */\n",
        ".search-row{\n",
        "  display:flex; justify-content:center;\n",
        "  margin:.1rem 0 .6rem;\n",
        "}\n",
        ".search-wrap{\n",
        "  position:relative;\n",
        "  width:min(360px, 100%);\n",
        "}\n",
        "#frag-search{\n",
        "  width:100%; padding:.55rem 1.1rem .55rem 2.4rem;\n",
        "  border:1px solid var(--line); border-radius:999px;\n",
        "  font-family:'Inter',system-ui,sans-serif; font-size:.9rem;\n",
        "  background:#fff; color:var(--ink);\n",
        "  outline:none; transition:border-color .15s, box-shadow .15s;\n",
        "}\n",
        "#frag-search:focus{\n",
        "  border-color:var(--accent);\n",
        "  box-shadow:0 0 0 3px rgba(169,111,47,.13);\n",
        "}\n",
        ".search-icon{\n",
        "  position:absolute; left:.85rem; top:50%; transform:translateY(-50%);\n",
        "  font-size:.9rem; pointer-events:none; color:var(--muted);\n",
        "}\n",
        ".search-clear{\n",
        "  position:absolute; right:.8rem; top:50%; transform:translateY(-50%);\n",
        "  background:none; border:none; cursor:pointer; color:var(--muted);\n",
        "  font-size:1rem; line-height:1; padding:.1rem; display:none;\n",
        "}\n",
        ".search-clear.visible{ display:block; }\n",
        ".search-clear:hover{ color:var(--accent); }\n",
        ".search-results{\n",
        "  position:absolute; top:calc(100% + .4rem); left:0; right:0;\n",
        "  background:#fff; border:1px solid var(--line); border-radius:16px;\n",
        "  box-shadow:0 10px 30px rgba(80,60,30,.13);\n",
        "  list-style:none; margin:0; padding:.35rem 0;\n",
        "  z-index:200; max-height:250px; overflow-y:auto;\n",
        "}\n",
        ".search-results.hidden{ display:none; }\n",
        ".search-results li{\n",
        "  padding:.5rem 1.1rem; cursor:pointer; font-size:.87rem;\n",
        "  display:flex; justify-content:space-between; align-items:center; gap:.5rem;\n",
        "  transition:background .1s;\n",
        "}\n",
        ".search-results li:hover{ background:#faf6ee; }\n",
        ".search-results li.no-match{ color:var(--muted); cursor:default; font-style:italic; }\n",
        ".search-results li.no-match:hover{ background:none; }\n",
        ".sr-name{ font-weight:500; }\n",
        ".sr-maker{ color:var(--muted); font-size:.78rem; white-space:nowrap; flex-shrink:0; }\n",
        "\n",
        "/* ── Fragram image ── */\n",
        ".frag-img-wrap{ text-align:right; flex-shrink:0; }\n",
        ".frag-img{\n",
        "  display:block; width:120px; height:120px; object-fit:contain;\n",
        "  border-radius:12px; background:#f8f4ec; border:1px solid var(--line);\n",
        "  margin-bottom:.55rem; cursor:zoom-in;\n",
        "  transition:opacity .15s, transform .15s;\n",
        "}\n",
        ".frag-img:hover{ opacity:.88; transform:scale(1.03); }\n",
        "\n",
        "/* ── Lightbox ── */\n",
        "#lightbox{\n",
        "  display:none; position:fixed; inset:0; z-index:1000;\n",
        "  background:rgba(30,24,16,.82); backdrop-filter:blur(6px);\n",
        "  align-items:center; justify-content:center; cursor:zoom-out;\n",
        "}\n",
        "#lightbox.open{ display:flex; }\n",
        "#lightbox img{\n",
        "  max-width:min(520px, 90vw); max-height:90vh;\n",
        "  object-fit:contain; border-radius:18px;\n",
        "  box-shadow:0 32px 80px rgba(0,0,0,.5);\n",
        "  animation:lb-in .18s ease;\n",
        "}\n",
        "@keyframes lb-in{\n",
        "  from{ opacity:0; transform:scale(.93); }\n",
        "  to{   opacity:1; transform:scale(1); }\n",
        "}\n",
        "\n",
        ".actions-row{ display:flex; flex-wrap:wrap; gap:.6rem; justify-content:center; align-items:center; margin:.5rem 0 1rem; }\n",
        ".actions-row button{ padding:.6rem 1.25rem; border-radius:999px; font-weight:600; cursor:pointer; border:1px solid var(--line); background:#fff; color:var(--ink); font-size:.9rem; }\n",
        "#btn-daily{ background:var(--ink); color:#fff; border-color:var(--ink); }\n",
        "#btn-random:hover{ border-color:var(--accent); color:var(--accent); }\n",
        ".check{ font-size:.85rem; color:#55503f; display:flex; align-items:center; gap:.4rem; cursor:pointer; }\n",
        ".sotd-sub{ text-align:center; color:var(--muted); margin:.2rem 0 .75rem; font-size:.9rem; }\n",
        ".frag-card{ background:var(--card); border:1px solid var(--line); border-radius:22px; box-shadow:var(--shadow); padding:2rem; }\n",
        ".frag-head{ display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; }\n",
        ".frag-name{ font-family:'Playfair Display',Georgia,serif; font-size:2.3rem; line-height:1.1; }\n",
        ".frag-maker{ color:var(--accent); letter-spacing:.09em; text-transform:uppercase; font-size:.78rem; margin-top:.35rem; font-weight:600; }\n",
        ".frag-rating{ text-align:right; }\n",
        ".stars-gold{ color:#d9a441; letter-spacing:.12em; font-size:1.1rem; }\n",
        ".rating-num{ color:var(--muted); font-size:.85rem; margin-top:.1rem; }\n",
        ".frag-meta{ display:flex; flex-wrap:wrap; gap:.4rem; margin:1.1rem 0; }\n",
        ".badge{ padding:.27rem .72rem; border-radius:999px; font-size:.75rem; font-weight:600; border:1px solid transparent; white-space:nowrap; }\n",
        ".meta{ background:#f1ebe0; color:#5f5646; border-color:#e0d6c4; }\n",
        ".s-spring{ background:#e7f0e2; color:#3f6b3a; }\n",
        ".s-summer{ background:#fdf0d5; color:#9a6b15; }\n",
        ".s-fall{ background:#f7e3d6; color:#a05526; }\n",
        ".s-winter{ background:#e2ebf5; color:#3c6190; }\n",
        ".s-all{ background:#eceef0; color:#5c6368; }\n",
        ".t-day{ background:#fdf0d5; color:#9a6b15; }\n",
        ".t-night{ background:#3a4052; color:#fff; }\n",
        ".t-flex{ background:#e3e8e3; color:#4c6656; }\n",
        ".frag-stats{ display:flex; flex-wrap:wrap; gap:1rem; margin:1rem 0 1.25rem; }\n",
        ".stat{ flex:1 1 0; min-width:130px; display:flex; gap:.6rem; align-items:center; background:#faf6ee; border:1px solid var(--line); border-radius:14px; padding:.8rem 1rem; }\n",
        ".stat-icon{ font-size:1.3rem; }\n",
        ".stat strong{ display:block; font-size:1.05rem; }\n",
        ".stat small{ color:var(--muted); font-size:.7rem; letter-spacing:.09em; text-transform:uppercase; }\n",
        ".dots{ color:var(--accent); letter-spacing:.14em; }\n",
        ".frag-note{ font-style:italic; color:var(--muted); margin:.25rem 0 .75rem; font-size:.9rem; }\n",
        ".pyramid{ display:grid; grid-template-columns:repeat(3,1fr); gap:.9rem; margin:1.25rem 0; }\n",
        ".pyr-col{ background:#faf6ee; border:1px solid var(--line); border-radius:14px; padding:.9rem; }\n",
        ".pyr-label{ font-size:.7rem; letter-spacing:.15em; text-transform:uppercase; color:var(--muted); margin-bottom:.55rem; font-weight:600; }\n",
        ".pyr-notes{ display:flex; flex-wrap:wrap; gap:.32rem; }\n",
        ".note-chip{ background:#fff; border:1px solid var(--line); color:#4a4337; padding:.22rem .6rem; border-radius:999px; font-size:.78rem; }\n",
        ".frag-perfumer{ margin:.4rem 0 1rem; font-size:.9rem; color:#55503f; }\n",
        ".frag-perfumer .lbl{ text-transform:uppercase; letter-spacing:.12em; font-size:.7rem; color:var(--muted); margin-right:.45rem; }\n",
        ".frag-actions{ display:flex; gap:.7rem; flex-wrap:wrap; margin-top:1.25rem; }\n",
        ".frag-link, .frag-wear{ display:inline-block; padding:.65rem 1.2rem; border-radius:999px; font-size:.9rem; font-weight:600; text-decoration:none; cursor:pointer; border:1px solid var(--accent); }\n",
        ".frag-link{ color:var(--accent); background:#fff; }\n",
        ".frag-link:hover{ background:var(--accent); color:#fff; }\n",
        ".frag-wear{ background:var(--accent); color:#fff; border-color:var(--accent); }\n",
        ".frag-wear:hover{ filter:brightness(1.06); }\n",
        ".history{ margin-top:2.5rem; text-align:center; }\n",
        ".history h3{ font-family:'Playfair Display',Georgia,serif; font-size:1.25rem; margin:0 0 .8rem; }\n",
        "#history-list{ display:flex; flex-wrap:wrap; gap:.5rem; justify-content:center; }\n",
        ".hist-chip{ background:#fff; border:1px solid var(--line); border-radius:999px; padding:.38rem .85rem; font-size:.82rem; }\n",
        ".hist-date{ color:var(--muted); font-size:.72rem; margin-left:.35rem; }\n",
        ".muted{ color:var(--muted); font-size:.85rem; }\n",
        "\n",
        "/* ── Weather bar ── */\n",
        ".weather-bar{\n",
        "  display:flex; align-items:center; justify-content:center;\n",
        "  gap:.55rem; flex-wrap:wrap;\n",
        "  background:rgba(255,255,255,.68); border:1px solid var(--line);\n",
        "  border-radius:14px; padding:.55rem 1.2rem;\n",
        "  margin:.6rem auto .1rem; max-width:700px;\n",
        "  font-size:.88rem; color:var(--ink); transition:opacity .3s;\n",
        "}\n",
        ".weather-bar.loading{ color:var(--muted); font-style:italic; }\n",
        ".weather-bar.hidden{ display:none !important; }\n",
        ".wx-temp{ font-weight:700; }\n",
        ".wx-cond{ color:var(--ink); }\n",
        ".wx-hint{ color:var(--muted); font-size:.78rem; }\n",
        ".wx-loc-input{\n",
        "  border:none; border-bottom:1px dashed var(--muted);\n",
        "  background:transparent; font-family:inherit; font-size:.88rem;\n",
        "  color:var(--accent); font-weight:600; width:10rem;\n",
        "  outline:none; padding:0 .1rem; cursor:text;\n",
        "}\n",
        ".wx-loc-input:focus{ border-bottom-color:var(--accent); }\n",
        "@media (max-width:640px){\n",
        "  .hero h1{ font-size:2.2rem; }\n",
        "  .frag-head{ flex-direction:column; }\n",
        "  .frag-rating{ text-align:left; }\n",
        "  .frag-img-wrap{ text-align:left; }\n",
        "  .frag-img{ width:80px; height:80px; }\n",
        "  .pyramid{ grid-template-columns:1fr; }\n",
        "  .frag-name{ font-size:1.9rem; }\n",
        "}\n",
        ".wear-panel{\n",
        "  margin:1.25rem 0 0; padding:1.1rem 1.15rem;\n",
        "  background:#faf6ee; border:1px solid var(--line); border-radius:16px;\n",
        "}\n",
        ".wear-panel-title{\n",
        "  font-size:.7rem; letter-spacing:.15em; text-transform:uppercase;\n",
        "  color:var(--muted); font-weight:600; margin-bottom:.75rem;\n",
        "}\n",
        ".wear-fields{ display:flex; flex-wrap:wrap; gap:.7rem; }\n",
        ".wear-fields label, .wear-notes-label{\n",
        "  display:flex; flex-direction:column; gap:.28rem;\n",
        "  font-size:.72rem; letter-spacing:.06em; text-transform:uppercase;\n",
        "  color:var(--muted); font-weight:600; flex:1 1 120px;\n",
        "}\n",
        ".wear-fields input, .wear-notes-label textarea{\n",
        "  font-family:'Inter',system-ui,sans-serif; font-size:.9rem; font-weight:400;\n",
        "  text-transform:none; letter-spacing:normal; color:var(--ink);\n",
        "  background:#fff; border:1px solid var(--line); border-radius:10px;\n",
        "  padding:.5rem .65rem; outline:none;\n",
        "}\n",
        ".wear-fields input:focus, .wear-notes-label textarea:focus{\n",
        "  border-color:var(--accent); box-shadow:0 0 0 3px rgba(169,111,47,.13);\n",
        "}\n",
        ".wear-notes-label{ margin-top:.8rem; flex-basis:100%; }\n",
        ".wear-notes-label textarea{ resize:vertical; line-height:1.45; }\n",
        "</style>\n",
        "\n",
        "<div class=\"sotd-wrap\">\n",
        "  <header class=\"hero\">\n",
        "    <h1>Scent of the Day</h1>\n",
        "    <p>A daily fragrance selector from your collection</p>\n",
        "  </header>\n",
        "\n",
        "  <div id=\"weather-bar\" class=\"weather-bar loading\">Fetching local weather…</div>\n",
        "  <p class=\"sotd-sub\" id=\"mode-label\">Today's selection</p>\n",
        "\n",
        "  <div class=\"controls\">\n",
        "    <div class=\"control-group\">\n",
        "      <span class=\"label\">Season</span>\n",
        "      <div class=\"chips\" id=\"season-chips\">\n",
        "        <button class=\"chip active\" data-season=\"All\">All</button>\n",
        "        <button class=\"chip\" data-season=\"Spring\">Spring</button>\n",
        "        <button class=\"chip\" data-season=\"Summer\">Summer</button>\n",
        "        <button class=\"chip\" data-season=\"Fall\">Fall</button>\n",
        "        <button class=\"chip\" data-season=\"Winter\">Winter</button>\n",
        "      </div>\n",
        "    </div>\n",
        "    <div class=\"control-group\">\n",
        "      <span class=\"label\">Time of day</span>\n",
        "      <div class=\"chips\" id=\"time-chips\">\n",
        "        <button class=\"chip active\" data-time=\"Any\">Any</button>\n",
        "        <button class=\"chip\" data-time=\"Day\">Day</button>\n",
        "        <button class=\"chip\" data-time=\"Night\">Night</button>\n",
        "        <button class=\"chip\" data-time=\"Flexible\">Flexible</button>\n",
        "      </div>\n",
        "    </div>\n",
        "  </div>\n",
        "\n",
        "  <!-- Search row — find a specific fragrance by name or house -->\n",
        "  <div class=\"search-row\">\n",
        "    <div class=\"search-wrap\">\n",
        "      <span class=\"search-icon\">🔍</span>\n",
        "      <input type=\"text\" id=\"frag-search\"\n",
        "             placeholder=\"Find a fragrance by name or house…\"\n",
        "             autocomplete=\"off\" spellcheck=\"false\">\n",
        "      <button class=\"search-clear\" id=\"search-clear\" aria-label=\"Clear search\">×</button>\n",
        "      <ul id=\"search-results\" class=\"search-results hidden\"></ul>\n",
        "    </div>\n",
        "  </div>\n",
        "\n",
        "  <div class=\"actions-row\">\n",
        "    <button id=\"btn-daily\">📅 Today's pick</button>\n",
        "    <button id=\"btn-random\">🎲 Surprise me</button>\n",
        "    <label class=\"check\"><input type=\"checkbox\" id=\"avoid\"> Skip worn in last 7 days</label>\n",
        "  </div>\n",
        "\n",
        "  <p class=\"sotd-sub\"><span id=\"meta-count\"></span></p>\n",
        "\n",
        "  <div id=\"frag-card\" class=\"frag-card\"></div>\n",
        "\n",
        "  <div class=\"history\">\n",
        "    <h3>Recently worn</h3>\n",
        "    <div id=\"history-list\"></div>\n",
        "    <div class=\"actions-row\" style=\"margin-top:1rem\">\n",
        "  <button id=\"btn-export-log\">⬇ Download wear log (CSV)</button>\n",
        "  <span class=\"muted\" id=\"log-count\"></span>\n",
        "</div>\n",
        "  </div>\n",
        "</div>\n",
        "\n",
        "<div id=\"lightbox\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Fragrance image\">\n",
        "  <img id=\"lightbox-img\" src=\"\" alt=\"\">\n",
        "</div>\n",
        "\n",
        "<script type=\"text/javascript\">\n",
        "(function(){\n",
        "  \"use strict\";\n",
        "\n",
        "  // ── Data ──────────────────────────────────────────────────────────────\n",
        "  // FRAGRANCES is injected by the Python chunk above at Quarto render time.\n",
        "  // Edit fragrances.csv, then re-render — no changes needed here.\n",
        "  const FRAGRANCES = (window.FRAGRANCES && window.FRAGRANCES.length)\n",
        "    ? window.FRAGRANCES\n",
        "    : [];\n",
        "\n",
        "  // ── DOM refs ──────────────────────────────────────────────────────────\n",
        "  const cardEl       = document.getElementById('frag-card');\n",
        "  const metaEl       = document.getElementById('meta-count');\n",
        "  const historyEl    = document.getElementById('history-list');\n",
        "  const avoidEl      = document.getElementById('avoid');\n",
        "  const modeLabel    = document.getElementById('mode-label');\n",
        "  const seasonChips  = document.querySelectorAll('#season-chips .chip');\n",
        "  const timeChips    = document.querySelectorAll('#time-chips .chip');\n",
        "  const searchInput  = document.getElementById('frag-search');\n",
        "  const searchResults= document.getElementById('search-results');\n",
        "  const searchClear  = document.getElementById('search-clear');\n",
        "\n",
        "  // ── State ─────────────────────────────────────────────────────────────\n",
        "  const state = { season: new Set(), time: new Set(), avoidRecent: false, current: null };\n",
        "\n",
        "  // Wear history lives in localStorage — persists across browser sessions.\n",
        "  let history = [];\n",
        "  try { history = JSON.parse(localStorage.getItem('sotd-history') || '[]'); } catch(e) { history = []; }\n",
        "  if (!Array.isArray(history)) history = [];\n",
        "\n",
        "  // ── Weather ───────────────────────────────────────────────────────────\n",
        "  let weatherState = null;\n",
        "  const DEFAULT_LOC = { name: 'Salem, OR', lat: 44.9429, lon: -123.0351 };\n",
        "  let savedLoc = DEFAULT_LOC;\n",
        "  try {\n",
        "    const stored = JSON.parse(localStorage.getItem('sotd-location') || 'null');\n",
        "    if (stored && stored.lat && stored.lon && stored.name) savedLoc = stored;\n",
        "  } catch(e){}\n",
        "\n",
        "  const WX_CODES = {\n",
        "    0:{icon:'☀️',lbl:'Clear'},    1:{icon:'🌤️',lbl:'Mainly clear'},\n",
        "    2:{icon:'⛅',lbl:'Partly cloudy'}, 3:{icon:'☁️',lbl:'Overcast'},\n",
        "    45:{icon:'🌫️',lbl:'Foggy'},   48:{icon:'🌫️',lbl:'Freezing fog'},\n",
        "    51:{icon:'🌦️',lbl:'Light drizzle'},53:{icon:'🌦️',lbl:'Drizzle'},\n",
        "    55:{icon:'🌧️',lbl:'Heavy drizzle'},\n",
        "    61:{icon:'🌧️',lbl:'Light rain'},63:{icon:'🌧️',lbl:'Rain'},65:{icon:'🌧️',lbl:'Heavy rain'},\n",
        "    71:{icon:'🌨️',lbl:'Light snow'},73:{icon:'❄️',lbl:'Snow'},75:{icon:'❄️',lbl:'Heavy snow'},\n",
        "    80:{icon:'🌦️',lbl:'Showers'},  81:{icon:'🌧️',lbl:'Heavy showers'},\n",
        "    82:{icon:'⛈️',lbl:'Violent showers'}, 95:{icon:'⛈️',lbl:'Thunderstorm'}\n",
        "  };\n",
        "  function wxDesc(code){\n",
        "    if (WX_CODES[code]) return WX_CODES[code];\n",
        "    if (code<=3)  return {icon:'⛅',lbl:'Cloudy'};\n",
        "    if (code<=48) return {icon:'🌫️',lbl:'Foggy'};\n",
        "    if (code<=67) return {icon:'🌧️',lbl:'Rainy'};\n",
        "    if (code<=77) return {icon:'❄️',lbl:'Snowy'};\n",
        "    if (code<=82) return {icon:'🌦️',lbl:'Showers'};\n",
        "    return {icon:'⛈️',lbl:'Stormy'};\n",
        "  }\n",
        "\n",
        "  function wxScore(f, wx){\n",
        "    if (!wx) return 3;\n",
        "    const temp    = wx.temperature_2m;\n",
        "    const code    = wx.weathercode;\n",
        "    const precip  = wx.precipitation || 0;\n",
        "    const seasons = Array.isArray(f.seasons) ? f.seasons : [];\n",
        "    const isAll   = seasons.indexOf('All') !== -1;\n",
        "    let   score   = 3;\n",
        "\n",
        "    if      (temp >= 82){ score += isAll ? 2 : (seasons.includes('Summer') ? 3 : seasons.includes('Spring') ? 1 : -2); }\n",
        "    else if (temp >= 65){ score += isAll ? 1 : (seasons.some(s => s==='Spring'||s==='Summer') ? 2 : seasons.includes('Fall') ? 0 : -1); }\n",
        "    else if (temp >= 50){ score += isAll ? 1 : (seasons.some(s => s==='Spring'||s==='Fall') ? 2 : 0); }\n",
        "    else if (temp >= 36){ score += isAll ? 1 : (seasons.some(s => s==='Fall'||s==='Winter') ? 2 : seasons.includes('Spring') ? -1 : -2); }\n",
        "    else                { score += isAll ? 2 : (seasons.includes('Winter') ? 3 : seasons.includes('Fall') ? 1 : -2); }\n",
        "\n",
        "    const isWet = precip > 0.3 || (code >= 51 && code <= 82);\n",
        "    if (isWet){ if ((f.sillage||3)<=2) score+=1; else if ((f.sillage||3)>=5) score-=1; }\n",
        "\n",
        "    return Math.max(1, score);\n",
        "  }\n",
        "\n",
        "  function wxHint(wx){\n",
        "    if (!wx) return '';\n",
        "    const temp   = wx.temperature_2m;\n",
        "    const code   = wx.weathercode;\n",
        "    const precip = wx.precipitation || 0;\n",
        "    const isWet  = precip > 0.3 || (code >= 51 && code <= 82);\n",
        "    let h;\n",
        "    if      (temp >= 82) h = 'warm day — lighter and fresher scents preferred';\n",
        "    else if (temp >= 65) h = 'comfortable out — spring and summer fragrances shine';\n",
        "    else if (temp >= 50) h = 'mild weather — versatile picks favored';\n",
        "    else if (temp >= 36) h = 'cool day — richer, warmer fragrances preferred';\n",
        "    else                 h = 'cold out — perfect for heavy orientals and leathers';\n",
        "    if (isWet) h += ' · lighter sillage in the rain';\n",
        "    return h;\n",
        "  }\n",
        "\n",
        "  function renderWeather(wx){\n",
        "    const bar = document.getElementById('weather-bar');\n",
        "    if (!bar) return;\n",
        "    const locInput = '<input id=\"wx-loc-input\" class=\"wx-loc-input\" value=\"' + esc(savedLoc.name) +\n",
        "                     '\" title=\"Type a city and press Enter\" aria-label=\"Location\">';\n",
        "    if (!wx){\n",
        "      bar.classList.remove('loading', 'hidden');\n",
        "      bar.innerHTML = '📍 ' + locInput;\n",
        "      wireLocInput(); return;\n",
        "    }\n",
        "    const d     = wxDesc(wx.weathercode);\n",
        "    const hint  = wxHint(wx);\n",
        "    const tempF = Math.round(wx.temperature_2m);\n",
        "    bar.classList.remove('loading', 'hidden');\n",
        "    bar.innerHTML =\n",
        "      '📍 ' + locInput + ' · ' +\n",
        "      d.icon +\n",
        "      ' <span class=\"wx-temp\">' + tempF + '°F</span>' +\n",
        "      ' <span class=\"wx-cond\">· ' + d.lbl + '</span>' +\n",
        "      (hint ? ' <span class=\"wx-hint\">· ' + esc(hint) + '</span>' : '');\n",
        "    wireLocInput();\n",
        "  }\n",
        "\n",
        "  function wireLocInput(){\n",
        "    const inp = document.getElementById('wx-loc-input');\n",
        "    if (!inp) return;\n",
        "    inp.addEventListener('keydown', function(e){\n",
        "      if (e.key === 'Enter'){ e.preventDefault(); geocodeAndFetch(inp.value.trim()); }\n",
        "      if (e.key === 'Escape'){ inp.value = savedLoc.name; inp.blur(); }\n",
        "    });\n",
        "  }\n",
        "\n",
        "  function fetchWeatherForLoc(loc){\n",
        "    const url = 'https://api.open-meteo.com/v1/forecast?latitude=' + loc.lat +\n",
        "                '&longitude=' + loc.lon +\n",
        "                '&current=temperature_2m,precipitation,weathercode' +\n",
        "                '&temperature_unit=fahrenheit&timezone=auto';\n",
        "    fetch(url)\n",
        "      .then(function(r){ return r.json(); })\n",
        "      .then(function(data){\n",
        "        weatherState = (data && data.current) || null;\n",
        "        renderWeather(weatherState);\n",
        "        render(pickDaily()); setMode('daily');\n",
        "      })\n",
        "      .catch(function(){ renderWeather(null); });\n",
        "  }\n",
        "\n",
        "  function geocodeAndFetch(query){\n",
        "    if (!query) return;\n",
        "    const bar = document.getElementById('weather-bar');\n",
        "    if (bar){ bar.classList.add('loading'); bar.textContent = 'Finding ' + query + '…'; }\n",
        "    const url = 'https://geocoding-api.open-meteo.com/v1/search?name=' +\n",
        "                encodeURIComponent(query) + '&count=1&language=en&format=json';\n",
        "    fetch(url)\n",
        "      .then(function(r){ return r.json(); })\n",
        "      .then(function(data){\n",
        "        const r = data && data.results && data.results[0];\n",
        "        if (!r){ renderWeather(weatherState); return; }\n",
        "        savedLoc = {\n",
        "          name: r.name + (r.admin1 ? ', ' + r.admin1 : ''),\n",
        "          lat:  r.latitude, lon: r.longitude\n",
        "        };\n",
        "        try { localStorage.setItem('sotd-location', JSON.stringify(savedLoc)); } catch(e){}\n",
        "        fetchWeatherForLoc(savedLoc);\n",
        "      })\n",
        "      .catch(function(){ renderWeather(weatherState); });\n",
        "  }\n",
        "\n",
        "  // ── Utilities ─────────────────────────────────────────────────────────\n",
        "  function todayKey(){\n",
        "    const d = new Date();\n",
        "    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');\n",
        "  }\n",
        "  function dayNumber(){\n",
        "    const d = new Date();\n",
        "    return Math.floor((d - new Date(d.getFullYear(), 0, 0)) / 86400000);\n",
        "  }\n",
        "  function mulberry32(seed){\n",
        "    return function(){\n",
        "      let t = seed += 0x6D2B79F5;\n",
        "      t = Math.imul(t ^ (t >>> 15), t | 1);\n",
        "      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n",
        "      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n",
        "    };\n",
        "  }\n",
        "  function esc(s){\n",
        "    if (s == null) return '';\n",
        "    return String(s).replace(/[&<>\"']/g, function(c){\n",
        "      return ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c];\n",
        "    });\n",
        "  }\n",
        "\n",
        "  // ── Filtering & selection ─────────────────────────────────────────────\n",
        "  function seasonMatch(f){\n",
        "    if (state.season.size === 0) return true;\n",
        "    const seasons = Array.isArray(f.seasons) ? f.seasons : [];\n",
        "    if (seasons.indexOf('All') !== -1) return true;\n",
        "    return seasons.some(function(s){ return state.season.has(s); });\n",
        "  }\n",
        "  function timeMatch(f){\n",
        "    if (state.time.size === 0) return true;\n",
        "    const t = f.time || 'Flexible';\n",
        "    if (t === 'Flexible') return true;\n",
        "    return state.time.has(t);\n",
        "  }\n",
        "  function recentNames(days){\n",
        "    const cutoff = Date.now() - days * 86400000;\n",
        "    const set = new Set();\n",
        "    history.forEach(function(h){ if ((h.ts || 0) >= cutoff) set.add(h.name); });\n",
        "    return set;\n",
        "  }\n",
        "  function baseCandidates(){\n",
        "    return FRAGRANCES.filter(function(f){ return seasonMatch(f) && timeMatch(f); });\n",
        "  }\n",
        "  function candidates(){\n",
        "    const base = baseCandidates();\n",
        "    if (state.avoidRecent){\n",
        "      const recent = recentNames(7);\n",
        "      const fresh = base.filter(function(f){ return !recent.has(f.name); });\n",
        "      if (fresh.length) return fresh;\n",
        "    }\n",
        "    return base.length ? base : FRAGRANCES;\n",
        "  }\n",
        "  function pickDaily(){\n",
        "    const list = candidates();\n",
        "    if (!list.length) return null;\n",
        "    const rng = mulberry32(new Date().getFullYear() * 1000 + dayNumber());\n",
        "    if (!weatherState) return list[Math.floor(rng() * list.length)];\n",
        "    const weights = list.map(f => wxScore(f, weatherState));\n",
        "    const total   = weights.reduce((a, b) => a + b, 0);\n",
        "    let r = rng() * total;\n",
        "    for (let i = 0; i < list.length; i++){\n",
        "      r -= weights[i];\n",
        "      if (r <= 0) return list[i];\n",
        "    }\n",
        "    return list[list.length - 1];\n",
        "  }\n",
        "  function pickRandom(){\n",
        "    const list = candidates();\n",
        "    return list[Math.floor(Math.random() * list.length)];\n",
        "  }\n",
        "\n",
        "  // ── Rendering ─────────────────────────────────────────────────────────\n",
        "  function stars(r){\n",
        "    if (r == null) return '';\n",
        "    const full = Math.round(r);\n",
        "    let s = '<span class=\"stars-gold\">';\n",
        "    for (let i = 0; i < 5; i++) s += (i < full) ? '★' : '☆';\n",
        "    return s + '</span>';\n",
        "  }\n",
        "  function dots(n){\n",
        "    if (n == null) return '';\n",
        "    let s = '';\n",
        "    for (let i = 1; i <= 5; i++) s += (i <= n) ? '●' : '○';\n",
        "    return s;\n",
        "  }\n",
        "  function chip(text, cls){\n",
        "    return '<span class=\"badge ' + cls + '\">' + esc(text) + '</span>';\n",
        "  }\n",
        "  const seasonClass = {'Spring':'s-spring','Summer':'s-summer','Fall':'s-fall','Autumn':'s-fall','Winter':'s-winter','All':'s-all'};\n",
        "  const timeClass   = {'Day':'t-day','Night':'t-night','Flexible':'t-flex'};\n",
        "\n",
        "  function seasonBadges(seasons){\n",
        "    if (!Array.isArray(seasons) || !seasons.length) return '';\n",
        "    return seasons.map(function(s){ return chip(s, seasonClass[s] || 's-all'); }).join('');\n",
        "  }\n",
        "  function pyramidHTML(p){\n",
        "    if (!p) return '';\n",
        "    const cols = [['top','Top'],['heart','Heart'],['base','Base']];\n",
        "    let out = '';\n",
        "    cols.forEach(function(c){\n",
        "      const notes = p[c[0]];\n",
        "      if (!Array.isArray(notes) || !notes.length) return;\n",
        "      let chipsHtml = '';\n",
        "      notes.forEach(function(n){ chipsHtml += '<span class=\"note-chip\">' + esc(n) + '</span>'; });\n",
        "      out += '<div class=\"pyr-col\"><div class=\"pyr-label\">' + c[1] + '</div><div class=\"pyr-notes\">' + chipsHtml + '</div></div>';\n",
        "    });\n",
        "    return out ? '<div class=\"pyramid\">' + out + '</div>' : '';\n",
        "  }\n",
        "\n",
        "  function render(f){\n",
        "    if (!f){\n",
        "      cardEl.innerHTML = '<p class=\"muted\">No fragrance matches your filters.</p>';\n",
        "      state.current = null;\n",
        "      return;\n",
        "    }\n",
        "    state.current = f;\n",
        "    const ratingTxt = (f.overall_rating != null) ? Number(f.overall_rating).toFixed(1) + ' / 5' : '—';\n",
        "    const metaParts = [];\n",
        "    if (f.concentration) metaParts.push(chip(f.concentration, 'meta'));\n",
        "    if (f.tier)          metaParts.push(chip(f.tier, 'meta'));\n",
        "    if (f.launch_year)   metaParts.push(chip('Est. ' + f.launch_year, 'meta'));\n",
        "    if (f.time)          metaParts.push(chip(f.time, timeClass[f.time] || 't-flex'));\n",
        "    const sb = seasonBadges(f.seasons);\n",
        "    if (sb) metaParts.push(sb);\n",
        "\n",
        "    let html = '';\n",
        "    html += '<div class=\"frag-head\">';\n",
        "    html += '<div><div class=\"frag-name\">' + esc(f.name) + '</div><div class=\"frag-maker\">' + esc(f.maker) + '</div></div>';\n",
        "    html += '<div class=\"frag-img-wrap\">';\n",
        "    if (f.fragram) {\n",
        "      html += '<img class=\"frag-img\" src=\"' + esc(f.fragram) + '\" alt=\"' + esc(f.name) + '\" loading=\"lazy\"' +\n",
        "              ' onerror=\"this.style.display=\\'none\\'\"' +\n",
        "              ' data-lightbox=\"' + esc(f.fragram) + '\">';\n",
        "    }\n",
        "    html += '<div class=\"frag-rating\"><div>' + stars(f.overall_rating) + '</div><div class=\"rating-num\">' + ratingTxt + '</div></div>';\n",
        "    html += '</div>';\n",
        "    html += '</div>';\n",
        "\n",
        "    html += '<div class=\"frag-meta\">' + metaParts.join('') + '</div>';\n",
        "\n",
        "    html += '<div class=\"frag-stats\">';\n",
        "    html += '<div class=\"stat\"><span class=\"stat-icon\">⏱️</span><div><strong>' + (f.longevity_hours != null ? f.longevity_hours + ' h' : '—') + '</strong><small>Longevity</small></div></div>';\n",
        "    html += '<div class=\"stat\"><span class=\"stat-icon\">📢</span><div><strong class=\"dots\">' + (dots(f.sillage) || '—') + '</strong><small>Sillage</small></div></div>';\n",
        "    html += '<div class=\"stat\"><span class=\"stat-icon\">🌫️</span><div><strong>' + esc(f.projection || '—') + '</strong><small>Projection</small></div></div>';\n",
        "    html += '</div>';\n",
        "\n",
        "    if (f.notes_raw) html += '<div class=\"frag-note\">' + esc(f.notes_raw) + '</div>';\n",
        "\n",
        "    html += pyramidHTML(f.pyramid);\n",
        "\n",
        "    if (f.perfumer) html += '<div class=\"frag-perfumer\"><span class=\"lbl\">Perfumer</span>' + esc(f.perfumer) + '</div>';\n",
        "html += '<div class=\"wear-panel\">';\n",
        "html += '<div class=\"wear-panel-title\">Log this wear</div>';\n",
        "html += '<div class=\"wear-fields\">';\n",
        "html += '<label>Occasion<input id=\"w-occasion\" type=\"text\" placeholder=\"work, dinner, hike\"></label>';\n",
        "html += '<label>Sprays<input id=\"w-sprays\" type=\"number\" min=\"1\" max=\"20\" step=\"1\" placeholder=\"2\"></label>';\n",
        "html += '<label>Your rating<input id=\"w-rating\" type=\"number\" min=\"1\" max=\"5\" step=\"0.5\" placeholder=\"4.5\"></label>';\n",
        "html += '<label>Longevity (h)<input id=\"w-longevity\" type=\"number\" min=\"0\" max=\"24\" step=\"0.5\" placeholder=\"8\"></label>';\n",
        "html += '<label>Sillage<input id=\"w-sillage\" type=\"number\" min=\"1\" max=\"5\" step=\"1\" placeholder=\"4\"></label>';\n",
        "html += '</div>';\n",
        "html += '<label class=\"wear-notes-label\">Observations';\n",
        "html += '<textarea id=\"w-notes\" rows=\"3\" placeholder=\"How did it wear? Projection, drydown, how it moved through the day, compliments…\"></textarea>';\n",
        "html += '</label>';\n",
        "html += '</div>';\n",
        "    html += '<div class=\"frag-actions\">';\n",
        "    if (f.scraped_url) html += '<a class=\"frag-link\" href=\"' + esc(f.scraped_url) + '\" target=\"_blank\" rel=\"noopener\">View on Fragrantica ↗</a>';\n",
        "html += '<button class=\"frag-wear\" type=\"button\">✔ Mark as worn + save notes</button>';    html += '</div>';\n",
        "\n",
        "    cardEl.innerHTML = html;\n",
        "    const wearBtn = cardEl.querySelector('.frag-wear');\n",
        "    if (wearBtn) wearBtn.addEventListener('click', markWorn);\n",
        "  }\n",
        "\n",
        "  function renderChips(){\n",
        "    seasonChips.forEach(function(c){\n",
        "      const v = c.dataset.season;\n",
        "      const active = (v === 'All') ? state.season.size === 0 : state.season.has(v);\n",
        "      c.classList.toggle('active', active);\n",
        "    });\n",
        "    timeChips.forEach(function(c){\n",
        "      const v = c.dataset.time;\n",
        "      const active = (v === 'Any') ? state.time.size === 0 : state.time.has(v);\n",
        "      c.classList.toggle('active', active);\n",
        "    });\n",
        "  }\n",
        "  function updateCount(){\n",
        "    const base = baseCandidates();\n",
        "    metaEl.textContent = base.length\n",
        "      ? base.length + ' of ' + FRAGRANCES.length + ' fragrances match'\n",
        "      : 'No matches — showing all ' + FRAGRANCES.length;\n",
        "  }\n",
        "  function setMode(mode, label){\n",
        "    const d = new Date();\n",
        "    const dateStr = d.toLocaleDateString(undefined, {weekday:'long', month:'long', day:'numeric'});\n",
        "    if (label) {\n",
        "      modeLabel.textContent = label;\n",
        "    } else {\n",
        "      modeLabel.textContent = (mode === 'daily') ? \"Today's selection · \" + dateStr : 'Random pick · ' + dateStr;\n",
        "    }\n",
        "  }\n",
        "  function renderHistory(){\n",
        "    const recents = history.slice(0, 8);\n",
        "    const cnt = document.getElementById('log-count');\n",
        "    if (cnt) cnt.textContent = history.length + ' wear' + (history.length === 1 ? '' : 's') + ' logged';\n",
        "    if (!recents.length){\n",
        "      historyEl.innerHTML = '<span class=\"muted\">Nothing marked as worn yet.</span>';\n",
        "      return;\n",
        "    }\n",
        "    let out = '';\n",
        "    recents.forEach(function(h){\n",
        "      const tip = h.notes ? ' title=\"' + esc(h.notes) + '\"' : '';\n",
        "      const dot = h.notes ? ' 📝' : '';\n",
        "      out += '<span class=\"hist-chip\"' + tip + '><strong>' + esc(h.name) + '</strong>' + dot +\n",
        "             '<span class=\"hist-date\">' + esc(h.date) + '</span></span>';\n",
        "    });\n",
        "    historyEl.innerHTML = out;\n",
        "  }\n",
        "  function markWorn(){\n",
        "    if (!state.current) return;\n",
        "\n",
        "    const f     = state.current;\n",
        "    const today = todayKey();\n",
        "    const id    = wearId(today, f.name, f.maker);\n",
        "    const p     = readPanel();\n",
        "    const wx    = weatherState || {};\n",
        "\n",
        "    // Replace only THIS fragrance's entry for today.\n",
        "    // The old code filtered on `date` alone, so wearing a second scent\n",
        "    // in the same day silently deleted the first one.\n",
        "    history = history.filter(function(h){ return h.wear_id !== id; });\n",
        "\n",
        "    history.push({\n",
        "      wear_id:         id,\n",
        "      date:            today,\n",
        "      name:            f.name,\n",
        "      maker:           f.maker,\n",
        "      occasion:        p.occasion,\n",
        "      sprays:          p.sprays,\n",
        "      temp_f:          (wx.temperature_2m != null) ? Math.round(wx.temperature_2m) : '',\n",
        "      weather:         (wx.weathercode    != null) ? wxDesc(wx.weathercode).lbl    : '',\n",
        "      rating_today:    p.rating_today,\n",
        "      longevity_obs_h: p.longevity_obs_h,\n",
        "      sillage_obs:     p.sillage_obs,\n",
        "      would_rewear:    '',\n",
        "      notes:           p.notes,\n",
        "      ts:              Date.now()\n",
        "    });\n",
        "\n",
        "    history.sort(function(a,b){ return (b.ts || 0) - (a.ts || 0); });\n",
        "    // NOTE: the old `history = history.slice(0, 50);` cap is intentionally removed.\n",
        "    // At one row per wear that cap discarded history after ~7 weeks.\n",
        "\n",
        "    persistHistory();\n",
        "    renderHistory();\n",
        "    clearPanel();\n",
        "  }\n",
        "  \n",
        "  // ── Filter chip events ────────────────────────────────────────────────\n",
        "  seasonChips.forEach(function(c){\n",
        "    c.addEventListener('click', function(){\n",
        "      const v = c.dataset.season;\n",
        "      if (v === 'All'){ state.season.clear(); }\n",
        "      else { if (state.season.has(v)) state.season.delete(v); else state.season.add(v); }\n",
        "      renderChips(); updateCount();\n",
        "      render(pickDaily()); setMode('daily');\n",
        "    });\n",
        "  });\n",
        "  timeChips.forEach(function(c){\n",
        "    c.addEventListener('click', function(){\n",
        "      const v = c.dataset.time;\n",
        "      if (v === 'Any'){ state.time.clear(); }\n",
        "      else { if (state.time.has(v)) state.time.delete(v); else state.time.add(v); }\n",
        "      renderChips(); updateCount();\n",
        "      render(pickDaily()); setMode('daily');\n",
        "    });\n",
        "  });\n",
        "  document.getElementById('btn-daily').addEventListener('click', function(){ render(pickDaily()); setMode('daily'); });\n",
        "  document.getElementById('btn-random').addEventListener('click', function(){ render(pickRandom()); setMode('random'); });\n",
        "  avoidEl.addEventListener('change', function(){ state.avoidRecent = avoidEl.checked; updateCount(); });\n",
        "\n",
        "  // ── Search ────────────────────────────────────────────────────────────\n",
        "  function buildSearchList(q){\n",
        "    if (!q){ searchResults.classList.add('hidden'); return; }\n",
        "    const lq = q.toLowerCase();\n",
        "    const hits = FRAGRANCES.filter(function(f){\n",
        "      return f.name.toLowerCase().includes(lq) ||\n",
        "             (f.maker || '').toLowerCase().includes(lq);\n",
        "    }).slice(0, 9);\n",
        "\n",
        "    if (!hits.length){\n",
        "      searchResults.innerHTML = '<li class=\"no-match\">No matches in your collection</li>';\n",
        "    } else {\n",
        "      searchResults.innerHTML = hits.map(function(f){\n",
        "        return '<li data-name=\"' + esc(f.name) + '\">' +\n",
        "               '<span class=\"sr-name\">' + esc(f.name) + '</span>' +\n",
        "               '<span class=\"sr-maker\">' + esc(f.maker) + '</span>' +\n",
        "               '</li>';\n",
        "      }).join('');\n",
        "      searchResults.querySelectorAll('li[data-name]').forEach(function(li){\n",
        "        li.addEventListener('click', function(){\n",
        "          const frag = FRAGRANCES.find(function(f){ return f.name === li.dataset.name; });\n",
        "          if (frag){\n",
        "            render(frag);\n",
        "            setMode('search', '🔍 Selected · ' + frag.name);\n",
        "          }\n",
        "          searchInput.value = '';\n",
        "          searchClear.classList.remove('visible');\n",
        "          searchResults.classList.add('hidden');\n",
        "        });\n",
        "      });\n",
        "    }\n",
        "    searchResults.classList.remove('hidden');\n",
        "  }\n",
        "\n",
        "  searchInput.addEventListener('input', function(){\n",
        "    const q = this.value.trim();\n",
        "    searchClear.classList.toggle('visible', q.length > 0);\n",
        "    buildSearchList(q);\n",
        "  });\n",
        "  searchInput.addEventListener('keydown', function(e){\n",
        "    if (e.key === 'Escape'){\n",
        "      searchInput.value = '';\n",
        "      searchClear.classList.remove('visible');\n",
        "      searchResults.classList.add('hidden');\n",
        "    }\n",
        "  });\n",
        "  searchClear.addEventListener('click', function(){\n",
        "    searchInput.value = '';\n",
        "    searchClear.classList.remove('visible');\n",
        "    searchResults.classList.add('hidden');\n",
        "    searchInput.focus();\n",
        "  });\n",
        "  document.addEventListener('click', function(e){\n",
        "    if (!e.target.closest('.search-wrap')) searchResults.classList.add('hidden');\n",
        "  });\n",
        "\n",
        "  // ── Lightbox ──────────────────────────────────────────────────────────\n",
        "  const lightbox    = document.getElementById('lightbox');\n",
        "  const lightboxImg = document.getElementById('lightbox-img');\n",
        "\n",
        "  document.addEventListener('click', function(e){\n",
        "    const trigger = e.target.closest('[data-lightbox]');\n",
        "    if (trigger){\n",
        "      lightboxImg.src = trigger.dataset.lightbox;\n",
        "      lightboxImg.alt = trigger.alt;\n",
        "      lightbox.classList.add('open');\n",
        "      return;\n",
        "    }\n",
        "    if (e.target === lightbox || e.target === lightboxImg){\n",
        "      lightbox.classList.remove('open');\n",
        "      lightboxImg.src = '';\n",
        "    }\n",
        "  });\n",
        "  document.addEventListener('keydown', function(e){\n",
        "    if (e.key === 'Escape') { lightbox.classList.remove('open'); lightboxImg.src = ''; }\n",
        "  });\n",
        "\n",
        "  // ── Init ──────────────────────────────────────────────────────────────\n",
        "  function init(){\n",
        "    renderChips();\n",
        "    updateCount();\n",
        "    const todayEntry = history.find(function(h){ return h.date === todayKey(); });\n",
        "    const f = todayEntry\n",
        "      ? (FRAGRANCES.find(function(x){ return x.name === todayEntry.name; }) || pickDaily())\n",
        "      : pickDaily();\n",
        "    render(f);\n",
        "    mergeLogs();\n",
        "      document.getElementById('btn-export-log').addEventListener('click', exportWearLog);\n",
        "    renderHistory();\n",
        "    setMode('daily');\n",
        "\n",
        "    fetchWeatherForLoc(savedLoc);\n",
        "  }\n",
        "\n",
        "  if (document.readyState === 'loading'){\n",
        "    document.addEventListener('DOMContentLoaded', init);\n",
        "  } else {\n",
        "    init();\n",
        "  }\n",
        "})();\n",
        "</script>\n",
        "\n",
        "```"
      ],
      "id": "15225e5f"
    }
