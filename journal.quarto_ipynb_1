    "#| echo: false\n",
    "#| output: asis\n",
    "import csv, html, collections, datetime\n",
    "\n",
    "def rd(path):\n",
    "    try:\n",
    "        with open(path, newline='', encoding='utf-8') as fh:\n",
    "            return [{(k or '').strip(): (v or '').strip()\n",
    "                     for k, v in r.items() if k} for r in csv.DictReader(fh)]\n",
    "    except FileNotFoundError:\n",
    "        return []\n",
    "\n",
    "def num(s):\n",
    "    try:    return float(s)\n",
    "    except (TypeError, ValueError): return None\n",
    "\n",
    "def dstr(s):\n",
    "    try:    return datetime.date.fromisoformat(s).strftime('%a %d %b %Y')\n",
    "    except Exception: return s or '—'\n",
    "\n",
    "E = html.escape\n",
    "log = [r for r in rd('wear_log.csv') if r.get('name')]\n",
    "cat = {r['name']: r for r in rd('fragrances.csv') if r.get('name')}\n",
    "\n",
    "groups = collections.OrderedDict()\n",
    "for r in log:\n",
    "    groups.setdefault((r['name'], r.get('maker', '')), []).append(r)\n",
    "for k in groups:\n",
    "    groups[k].sort(key=lambda r: (r.get('date', ''), r.get('ts', '')), reverse=True)\n",
    "groups = collections.OrderedDict(\n",
    "    sorted(groups.items(), key=lambda kv: kv[1][0].get('date', ''), reverse=True))\n",
    "\n",
    "out = []\n",
    "out.append('<div class=\"wj-wrap\">')\n",
    "out.append('<header class=\"wj-hero\"><h1>Wear Journal</h1>'\n",
    "           '<p>Personal observations · one row per wear</p>'\n",
    "           '<a class=\"wj-back\" href=\"index.html\">← Back to the selector</a></header>')\n",
    "\n",
    "if not log:\n",
    "    out.append('<div class=\"wj-none\">No wears logged yet. Mark a fragrance as worn '\n",
    "               'on the selector, then download and commit <code>wear_log.csv</code>.</div>')\n",
    "else:\n",
    "    dates = sorted(r.get('date', '') for r in log if r.get('date'))\n",
    "    out.append('<div class=\"wj-sum\">')\n",
    "    for big, small in [(str(len(log)), 'wears logged'),\n",
    "                       (str(len(groups)), 'fragrances worn'),\n",
    "                       (dstr(dates[0]), 'first entry'),\n",
    "                       (dstr(dates[-1]), 'latest entry')]:\n",
    "        out.append('<div class=\"wj-stat\"><strong>' + E(big) + '</strong><small>'\n",
    "                   + E(small) + '</small></div>')\n",
    "    out.append('</div>')\n",
    "\n",
    "    for (name, maker), wears in groups.items():\n",
    "        claimed = cat.get(name, {})\n",
    "        rt = [num(w.get('rating_today', '')) for w in wears]\n",
    "        rt = [x for x in rt if x is not None]\n",
    "        lo = [num(w.get('longevity_obs_h', '')) for w in wears]\n",
    "        lo = [x for x in lo if x is not None]\n",
    "\n",
    "        out.append('<div class=\"wj-card\">')\n",
    "        out.append('<h2>' + E(name) + '</h2>')\n",
    "        out.append('<div class=\"wj-maker\">' + E(maker) + '</div>')\n",
    "\n",
    "        out.append('<div class=\"wj-obs\">')\n",
    "        out.append('<span class=\"wj-badge\">' + str(len(wears)) + ' wear'\n",
    "                   + ('' if len(wears) == 1 else 's') + '</span>')\n",
    "        if rt:\n",
    "            out.append('<span class=\"wj-badge\">your avg '\n",
    "                       + str(round(sum(rt)/len(rt), 1)) + ' / 5</span>')\n",
    "        if lo:\n",
    "            obs = sum(lo)/len(lo)\n",
    "            out.append('<span class=\"wj-badge\">obs '\n",
    "                       + str(round(obs, 1)) + ' h</span>')\n",
    "            cl = num(claimed.get('longevity_hours', ''))\n",
    "            if cl:\n",
    "                d = obs - cl\n",
    "                cls = 'hi' if d > 0.5 else ('lo' if d < -0.5 else '')\n",
    "                out.append('<span class=\"wj-badge ' + cls + '\">vs claimed '\n",
    "                           + ('%+.1f' % d) + ' h</span>')\n",
    "        cw = num(claimed.get('overall_rating', ''))\n",
    "        if cw:\n",
    "            out.append('<span class=\"wj-badge\">crowd '\n",
    "                       + str(round(cw, 1)) + '</span>')\n",
    "        out.append('</div>')\n",
    "\n",
    "        for w in wears:\n",
    "            facts = []\n",
    "            if w.get('occasion'): facts.append(E(w['occasion']))\n",
    "            if w.get('sprays'):   facts.append(E(w['sprays']) + ' sprays')\n",
    "            if w.get('temp_f'):   facts.append(E(w['temp_f']) + '°F')\n",
    "            if w.get('weather'):  facts.append(E(w['weather']))\n",
    "            if w.get('rating_today'): facts.append('rated ' + E(w['rating_today']))\n",
    "            if w.get('longevity_obs_h'): facts.append(E(w['longevity_obs_h']) + ' h')\n",
    "            out.append('<div class=\"wj-entry\">')\n",
    "            out.append('<div class=\"wj-date\">' + E(dstr(w.get('date', ''))) + '</div>')\n",
    "            if facts:\n",
    "                out.append('<div class=\"wj-facts\">' + ' · '.join(facts) + '</div>')\n",
    "            n = (w.get('notes') or '').strip()\n",
    "            if n:\n",
    "                out.append('<div class=\"wj-notes\">' + E(n) + '</div>')\n",
    "            out.append('</div>')\n",
    "\n",
    "        out.append('</div>')\n",
    "\n",
    "out.append('</div>')\n",
    "print(''.join(out))"
   ]
