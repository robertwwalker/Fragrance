    "#| echo: false\n",
    "#| output: asis\n",
    "#\n",
    "# DATA SOURCE: fragrances.csv (must live in the same folder as this .qmd)\n",
    "#\n",
    "# To update the collection:\n",
    "#   1. Edit fragrances.csv  (any spreadsheet app or text editor)\n",
    "#   2. Run:  quarto render index-weather.qmd\n",
    "#   The rebuilt HTML embeds the new data; no JS edits needed.\n",
    "#\n",
    "# Pipe-separated list columns: seasons, top_notes, heart_notes, base_notes\n",
    "#   e.g.  seasons = Fall|Winter      top_notes = Saffron|Rose|Bergamot\n",
    "#\n",
    "import csv, json, sys, os\n",
    "\n",
    "def _list(s):\n",
    "    if not s or not str(s).strip():\n",
    "        return []\n",
    "    return [x.strip() for x in str(s).split('|') if x.strip()]\n",
    "\n",
    "def _num(s, as_float=False):\n",
    "    if s is None or not str(s).strip():\n",
    "        return None\n",
    "    try:\n",
    "        return float(s) if as_float else int(float(s))\n",
    "    except (ValueError, TypeError):\n",
    "        return None\n",
    "\n",
    "fragrances = []\n",
    "try:\n",
    "    with open('fragrances.csv', newline='', encoding='utf-8') as fh:\n",
    "        for row in csv.DictReader(fh):\n",
    "            pyr = {\n",
    "                'top':   _list(row.get('top_notes',   '')),\n",
    "                'heart': _list(row.get('heart_notes', '')),\n",
    "                'base':  _list(row.get('base_notes',  ''))\n",
    "            }\n",
    "            f = {'name': row['name'].strip(), 'maker': row['maker'].strip()}\n",
    "            for field in ['concentration','tier','status','notes_raw','projection',\n",
    "                          'perfumer','scraped_url','url_status','time','fragram']:\n",
    "                f[field] = row.get(field, '').strip()\n",
    "            for field, af in [('longevity_hours', False), ('sillage', False),\n",
    "                               ('overall_rating',  True),  ('launch_year', False)]:\n",
    "                f[field] = _num(row.get(field, ''), af)\n",
    "            f['seasons'] = _list(row.get('seasons', ''))\n",
    "            f['pyramid'] = pyr\n",
    "            note = row.get('note', '').strip()\n",
    "            if note:\n",
    "                f['note'] = note\n",
    "            fragrances.append(f)\n",
    "except FileNotFoundError:\n",
    "    print('<script>console.error(\"[SOTD] fragrances.csv not found — '\n",
    "          'place it next to index-weather.qmd and re-render.\");</script>')\n",
    "\n",
    "print('<script>window.FRAGRANCES = ' +\n",
    "      json.dumps(fragrances, ensure_ascii=False) + ';</script>')"
   ]
