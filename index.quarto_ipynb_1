    "  .hero h1{ font-size:2.2rem; }\n",
    "  .frag-head{ flex-direction:column; }\n",
    "  .frag-rating{ text-align:left; }\n",
    "  .frag-img-wrap{ text-align:left; }\n",
    "  .frag-img{ width:80px; height:80px; }\n",
    "  .pyramid{ grid-template-columns:1fr; }\n",
    "  .frag-name{ font-size:1.9rem; }\n",
    "}\n",
    "</style>\n",
    "\n",
    "<div class=\"sotd-wrap\">\n",
    "  <header class=\"hero\">\n",
    "    <h1>Scent of the Day</h1>\n",
    "    <p>A daily fragrance selector from your collection</p>\n",
    "  </header>\n",
    "\n",
    "  <div id=\"weather-bar\" class=\"weather-bar loading\">Fetching local weather…</div>\n",
    "  <p class=\"sotd-sub\" id=\"mode-label\">Today's selection</p>\n",
    "\n",
    "  <div class=\"controls\">\n",
    "    <div class=\"control-group\">\n",
    "      <span class=\"label\">Season</span>\n",
    "      <div class=\"chips\" id=\"season-chips\">\n",
    "        <button class=\"chip active\" data-season=\"All\">All</button>\n",
    "        <button class=\"chip\" data-season=\"Spring\">Spring</button>\n",
    "        <button class=\"chip\" data-season=\"Summer\">Summer</button>\n",
    "        <button class=\"chip\" data-season=\"Fall\">Fall</button>\n",
    "        <button class=\"chip\" data-season=\"Winter\">Winter</button>\n",
    "      </div>\n",
    "    </div>\n",
    "    <div class=\"control-group\">\n",
    "      <span class=\"label\">Time of day</span>\n",
    "      <div class=\"chips\" id=\"time-chips\">\n",
    "        <button class=\"chip active\" data-time=\"Any\">Any</button>\n",
    "        <button class=\"chip\" data-time=\"Day\">Day</button>\n",
    "        <button class=\"chip\" data-time=\"Night\">Night</button>\n",
    "        <button class=\"chip\" data-time=\"Flexible\">Flexible</button>\n",
    "      </div>\n",
    "    </div>\n",
    "  </div>\n",
    "\n",
    "  <!-- Search row — find a specific fragrance by name or house -->\n",
    "  <div class=\"search-row\">\n",
    "    <div class=\"search-wrap\">\n",
    "      <span class=\"search-icon\">🔍</span>\n",
    "      <input type=\"text\" id=\"frag-search\"\n",
    "             placeholder=\"Find a fragrance by name or house…\"\n",
    "             autocomplete=\"off\" spellcheck=\"false\">\n",
    "      <button class=\"search-clear\" id=\"search-clear\" aria-label=\"Clear search\">×</button>\n",
    "      <ul id=\"search-results\" class=\"search-results hidden\"></ul>\n",
    "    </div>\n",
    "  </div>\n",
    "\n",
    "  <div class=\"actions-row\">\n",
    "    <button id=\"btn-daily\">📅 Today's pick</button>\n",
    "    <button id=\"btn-random\">🎲 Surprise me</button>\n",
    "    <label class=\"check\"><input type=\"checkbox\" id=\"avoid\"> Skip worn in last 7 days</label>\n",
    "  </div>\n",
    "\n",
    "  <p class=\"sotd-sub\"><span id=\"meta-count\"></span></p>\n",
    "\n",
    "  <div id=\"frag-card\" class=\"frag-card\"></div>\n",
    "\n",
    "  <div class=\"history\">\n",
    "    <h3>Recently worn</h3>\n",
    "    <div id=\"history-list\"></div>\n",
    "  </div>\n",
    "</div>\n",
    "\n",
    "<div id=\"lightbox\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Fragrance image\">\n",
    "  <img id=\"lightbox-img\" src=\"\" alt=\"\">\n",
    "</div>\n",
    "\n",
    "<script type=\"text/javascript\">\n",
    "(function(){\n",
    "  \"use strict\";\n",
    "\n",
    "  // ── Data ──────────────────────────────────────────────────────────────\n",
    "  // FRAGRANCES is injected by the Python chunk above at Quarto render time.\n",
    "  // Edit fragrances.csv, then re-render — no changes needed here.\n",
    "  const FRAGRANCES = (window.FRAGRANCES && window.FRAGRANCES.length)\n",
    "    ? window.FRAGRANCES\n",
    "    : [];\n",
    "\n",
    "  // ── DOM refs ──────────────────────────────────────────────────────────\n",
    "  const cardEl       = document.getElementById('frag-card');\n",
    "  const metaEl       = document.getElementById('meta-count');\n",
    "  const historyEl    = document.getElementById('history-list');\n",
    "  const avoidEl      = document.getElementById('avoid');\n",
    "  const modeLabel    = document.getElementById('mode-label');\n",
    "  const seasonChips  = document.querySelectorAll('#season-chips .chip');\n",
    "  const timeChips    = document.querySelectorAll('#time-chips .chip');\n",
    "  const searchInput  = document.getElementById('frag-search');\n",
    "  const searchResults= document.getElementById('search-results');\n",
    "  const searchClear  = document.getElementById('search-clear');\n",
    "\n",
    "  // ── State ─────────────────────────────────────────────────────────────\n",
    "  const state = { season: new Set(), time: new Set(), avoidRecent: false, current: null };\n",
    "\n",
    "  // Wear history lives in localStorage — persists across browser sessions.\n",
    "  let history = [];\n",
    "  try { history = JSON.parse(localStorage.getItem('sotd-history') || '[]'); } catch(e) { history = []; }\n",
    "  if (!Array.isArray(history)) history = [];\n",
    "\n",
    "  // ── Weather ───────────────────────────────────────────────────────────\n",
    "  let weatherState = null;\n",
    "  const DEFAULT_LOC = { name: 'Salem, OR', lat: 44.9429, lon: -123.0351 };\n",
    "  let savedLoc = DEFAULT_LOC;\n",
    "  try {\n",
    "    const stored = JSON.parse(localStorage.getItem('sotd-location') || 'null');\n",
    "    if (stored && stored.lat && stored.lon && stored.name) savedLoc = stored;\n",
    "  } catch(e){}\n",
    "\n",
    "  const WX_CODES = {\n",
    "    0:{icon:'☀️',lbl:'Clear'},    1:{icon:'🌤️',lbl:'Mainly clear'},\n",
    "    2:{icon:'⛅',lbl:'Partly cloudy'}, 3:{icon:'☁️',lbl:'Overcast'},\n",
    "    45:{icon:'🌫️',lbl:'Foggy'},   48:{icon:'🌫️',lbl:'Freezing fog'},\n",
    "    51:{icon:'🌦️',lbl:'Light drizzle'},53:{icon:'🌦️',lbl:'Drizzle'},\n",
    "    55:{icon:'🌧️',lbl:'Heavy drizzle'},\n",
    "    61:{icon:'🌧️',lbl:'Light rain'},63:{icon:'🌧️',lbl:'Rain'},65:{icon:'🌧️',lbl:'Heavy rain'},\n",
    "    71:{icon:'🌨️',lbl:'Light snow'},73:{icon:'❄️',lbl:'Snow'},75:{icon:'❄️',lbl:'Heavy snow'},\n",
    "    80:{icon:'🌦️',lbl:'Showers'},  81:{icon:'🌧️',lbl:'Heavy showers'},\n",
    "    82:{icon:'⛈️',lbl:'Violent showers'}, 95:{icon:'⛈️',lbl:'Thunderstorm'}\n",
    "  };\n",
    "  function wxDesc(code){\n",
    "    if (WX_CODES[code]) return WX_CODES[code];\n",
    "    if (code<=3)  return {icon:'⛅',lbl:'Cloudy'};\n",
    "    if (code<=48) return {icon:'🌫️',lbl:'Foggy'};\n",
    "    if (code<=67) return {icon:'🌧️',lbl:'Rainy'};\n",
    "    if (code<=77) return {icon:'❄️',lbl:'Snowy'};\n",
    "    if (code<=82) return {icon:'🌦️',lbl:'Showers'};\n",
    "    return {icon:'⛈️',lbl:'Stormy'};\n",
    "  }\n",
    "\n",
    "  function wxScore(f, wx){\n",
    "    if (!wx) return 3;\n",
    "    const temp    = wx.temperature_2m;\n",
    "    const code    = wx.weathercode;\n",
    "    const precip  = wx.precipitation || 0;\n",
    "    const seasons = Array.isArray(f.seasons) ? f.seasons : [];\n",
    "    const isAll   = seasons.indexOf('All') !== -1;\n",
    "    let   score   = 3;\n",
    "\n",
    "    if      (temp >= 82){ score += isAll ? 2 : (seasons.includes('Summer') ? 3 : seasons.includes('Spring') ? 1 : -2); }\n",
    "    else if (temp >= 65){ score += isAll ? 1 : (seasons.some(s => s==='Spring'||s==='Summer') ? 2 : seasons.includes('Fall') ? 0 : -1); }\n",
    "    else if (temp >= 50){ score += isAll ? 1 : (seasons.some(s => s==='Spring'||s==='Fall') ? 2 : 0); }\n",
    "    else if (temp >= 36){ score += isAll ? 1 : (seasons.some(s => s==='Fall'||s==='Winter') ? 2 : seasons.includes('Spring') ? -1 : -2); }\n",
    "    else                { score += isAll ? 2 : (seasons.includes('Winter') ? 3 : seasons.includes('Fall') ? 1 : -2); }\n",
    "\n",
    "    const isWet = precip > 0.3 || (code >= 51 && code <= 82);\n",
    "    if (isWet){ if ((f.sillage||3)<=2) score+=1; else if ((f.sillage||3)>=5) score-=1; }\n",
    "\n",
    "    return Math.max(1, score);\n",
    "  }\n",
    "\n",
    "  function wxHint(wx){\n",
    "    if (!wx) return '';\n",
    "    const temp   = wx.temperature_2m;\n",
    "    const code   = wx.weathercode;\n",
    "    const precip = wx.precipitation || 0;\n",
    "    const isWet  = precip > 0.3 || (code >= 51 && code <= 82);\n",
    "    let h;\n",
    "    if      (temp >= 82) h = 'warm day — lighter and fresher scents preferred';\n",
    "    else if (temp >= 65) h = 'comfortable out — spring and summer fragrances shine';\n",
    "    else if (temp >= 50) h = 'mild weather — versatile picks favored';\n",
    "    else if (temp >= 36) h = 'cool day — richer, warmer fragrances preferred';\n",
    "    else                 h = 'cold out — perfect for heavy orientals and leathers';\n",
    "    if (isWet) h += ' · lighter sillage in the rain';\n",
    "    return h;\n",
    "  }\n",
    "\n",
    "  function renderWeather(wx){\n",
    "    const bar = document.getElementById('weather-bar');\n",
    "    if (!bar) return;\n",
    "    const locInput = '<input id=\"wx-loc-input\" class=\"wx-loc-input\" value=\"' + esc(savedLoc.name) +\n",
    "                     '\" title=\"Type a city and press Enter\" aria-label=\"Location\">';\n",
    "    if (!wx){\n",
    "      bar.classList.remove('loading', 'hidden');\n",
    "      bar.innerHTML = '📍 ' + locInput;\n",
    "      wireLocInput(); return;\n",
    "    }\n",
    "    const d     = wxDesc(wx.weathercode);\n",
    "    const hint  = wxHint(wx);\n",
    "    const tempF = Math.round(wx.temperature_2m);\n",
    "    bar.classList.remove('loading', 'hidden');\n",
    "    bar.innerHTML =\n",
    "      '📍 ' + locInput + ' · ' +\n",
    "      d.icon +\n",
    "      ' <span class=\"wx-temp\">' + tempF + '°F</span>' +\n",
    "      ' <span class=\"wx-cond\">· ' + d.lbl + '</span>' +\n",
    "      (hint ? ' <span class=\"wx-hint\">· ' + esc(hint) + '</span>' : '');\n",
    "    wireLocInput();\n",
    "  }\n",
    "\n",
    "  function wireLocInput(){\n",
    "    const inp = document.getElementById('wx-loc-input');\n",
    "    if (!inp) return;\n",
    "    inp.addEventListener('keydown', function(e){\n",
    "      if (e.key === 'Enter'){ e.preventDefault(); geocodeAndFetch(inp.value.trim()); }\n",
    "      if (e.key === 'Escape'){ inp.value = savedLoc.name; inp.blur(); }\n",
    "    });\n",
    "  }\n",
    "\n",
    "  function fetchWeatherForLoc(loc){\n",
    "    const url = 'https://api.open-meteo.com/v1/forecast?latitude=' + loc.lat +\n",
    "                '&longitude=' + loc.lon +\n",
    "                '&current=temperature_2m,precipitation,weathercode' +\n",
    "                '&temperature_unit=fahrenheit&timezone=auto';\n",
    "    fetch(url)\n",
    "      .then(function(r){ return r.json(); })\n",
    "      .then(function(data){\n",
    "        weatherState = (data && data.current) || null;\n",
    "        renderWeather(weatherState);\n",
    "        render(pickDaily()); setMode('daily');\n",
    "      })\n",
    "      .catch(function(){ renderWeather(null); });\n",
    "  }\n",
    "\n",
    "  function geocodeAndFetch(query){\n",
    "    if (!query) return;\n",
    "    const bar = document.getElementById('weather-bar');\n",
    "    if (bar){ bar.classList.add('loading'); bar.textContent = 'Finding ' + query + '…'; }\n",
    "    const url = 'https://geocoding-api.open-meteo.com/v1/search?name=' +\n",
    "                encodeURIComponent(query) + '&count=1&language=en&format=json';\n",
    "    fetch(url)\n",
    "      .then(function(r){ return r.json(); })\n",
    "      .then(function(data){\n",
    "        const r = data && data.results && data.results[0];\n",
    "        if (!r){ renderWeather(weatherState); return; }\n",
    "        savedLoc = {\n",
    "          name: r.name + (r.admin1 ? ', ' + r.admin1 : ''),\n",
    "          lat:  r.latitude, lon: r.longitude\n",
    "        };\n",
    "        try { localStorage.setItem('sotd-location', JSON.stringify(savedLoc)); } catch(e){}\n",
    "        fetchWeatherForLoc(savedLoc);\n",
    "      })\n",
    "      .catch(function(){ renderWeather(weatherState); });\n",
    "  }\n",
    "\n",
    "  // ── Utilities ─────────────────────────────────────────────────────────\n",
    "  function todayKey(){\n",
    "    const d = new Date();\n",
    "    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');\n",
    "  }\n",
    "  function dayNumber(){\n",
    "    const d = new Date();\n",
    "    return Math.floor((d - new Date(d.getFullYear(), 0, 0)) / 86400000);\n",
    "  }\n",
    "  function mulberry32(seed){\n",
    "    return function(){\n",
    "      let t = seed += 0x6D2B79F5;\n",
    "      t = Math.imul(t ^ (t >>> 15), t | 1);\n",
    "      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n",
    "      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n",
    "    };\n",
    "  }\n",
    "  function esc(s){\n",
    "    if (s == null) return '';\n",
    "    return String(s).replace(/[&<>\"']/g, function(c){\n",
    "      return ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c];\n",
    "    });\n",
    "  }\n",
    "\n",
    "  // ── Filtering & selection ─────────────────────────────────────────────\n",
    "  function seasonMatch(f){\n",
    "    if (state.season.size === 0) return true;\n",
    "    const seasons = Array.isArray(f.seasons) ? f.seasons : [];\n",
    "    if (seasons.indexOf('All') !== -1) return true;\n",
    "    return seasons.some(function(s){ return state.season.has(s); });\n",
    "  }\n",
    "  function timeMatch(f){\n",
    "    if (state.time.size === 0) return true;\n",
    "    const t = f.time || 'Flexible';\n",
    "    if (t === 'Flexible') return true;\n",
    "    return state.time.has(t);\n",
    "  }\n",
    "  function recentNames(days){\n",
    "    const cutoff = Date.now() - days * 86400000;\n",
    "    const set = new Set();\n",
    "    history.forEach(function(h){ if ((h.ts || 0) >= cutoff) set.add(h.name); });\n",
    "    return set;\n",
    "  }\n",
    "  function baseCandidates(){\n",
    "    return FRAGRANCES.filter(function(f){ return seasonMatch(f) && timeMatch(f); });\n",
    "  }\n",
    "  function candidates(){\n",
    "    const base = baseCandidates();\n",
    "    if (state.avoidRecent){\n",
    "      const recent = recentNames(7);\n",
    "      const fresh = base.filter(function(f){ return !recent.has(f.name); });\n",
    "      if (fresh.length) return fresh;\n",
    "    }\n",
    "    return base.length ? base : FRAGRANCES;\n",
    "  }\n",
    "  function pickDaily(){\n",
    "    const list = candidates();\n",
    "    if (!list.length) return null;\n",
    "    const rng = mulberry32(new Date().getFullYear() * 1000 + dayNumber());\n",
    "    if (!weatherState) return list[Math.floor(rng() * list.length)];\n",
    "    const weights = list.map(f => wxScore(f, weatherState));\n",
    "    const total   = weights.reduce((a, b) => a + b, 0);\n",
    "    let r = rng() * total;\n",
    "    for (let i = 0; i < list.length; i++){\n",
    "      r -= weights[i];\n",
    "      if (r <= 0) return list[i];\n",
    "    }\n",
    "    return list[list.length - 1];\n",
    "  }\n",
    "  function pickRandom(){\n",
    "    const list = candidates();\n",
    "    return list[Math.floor(Math.random() * list.length)];\n",
    "  }\n",
    "\n",
    "  // ── Rendering ─────────────────────────────────────────────────────────\n",
    "  function stars(r){\n",
    "    if (r == null) return '';\n",
    "    const full = Math.round(r);\n",
    "    let s = '<span class=\"stars-gold\">';\n",
    "    for (let i = 0; i < 5; i++) s += (i < full) ? '★' : '☆';\n",
    "    return s + '</span>';\n",
    "  }\n",
    "  function dots(n){\n",
    "    if (n == null) return '';\n",
    "    let s = '';\n",
    "    for (let i = 1; i <= 5; i++) s += (i <= n) ? '●' : '○';\n",
    "    return s;\n",
    "  }\n",
    "  function chip(text, cls){\n",
    "    return '<span class=\"badge ' + cls + '\">' + esc(text) + '</span>';\n",
    "  }\n",
    "  const seasonClass = {'Spring':'s-spring','Summer':'s-summer','Fall':'s-fall','Autumn':'s-fall','Winter':'s-winter','All':'s-all'};\n",
    "  const timeClass   = {'Day':'t-day','Night':'t-night','Flexible':'t-flex'};\n",
    "\n",
    "  function seasonBadges(seasons){\n",
    "    if (!Array.isArray(seasons) || !seasons.length) return '';\n",
    "    return seasons.map(function(s){ return chip(s, seasonClass[s] || 's-all'); }).join('');\n",
    "  }\n",
    "  function pyramidHTML(p){\n",
    "    if (!p) return '';\n",
    "    const cols = [['top','Top'],['heart','Heart'],['base','Base']];\n",
    "    let out = '';\n",
    "    cols.forEach(function(c){\n",
    "      const notes = p[c[0]];\n",
    "      if (!Array.isArray(notes) || !notes.length) return;\n",
    "      let chipsHtml = '';\n",
    "      notes.forEach(function(n){ chipsHtml += '<span class=\"note-chip\">' + esc(n) + '</span>'; });\n",
    "      out += '<div class=\"pyr-col\"><div class=\"pyr-label\">' + c[1] + '</div><div class=\"pyr-notes\">' + chipsHtml + '</div></div>';\n",
    "    });\n",
    "    return out ? '<div class=\"pyramid\">' + out + '</div>' : '';\n",
    "  }\n",
    "\n",
    "  function render(f){\n",
    "    if (!f){\n",
    "      cardEl.innerHTML = '<p class=\"muted\">No fragrance matches your filters.</p>';\n",
    "      state.current = null;\n",
    "      return;\n",
    "    }\n",
    "    state.current = f;\n",
    "    const ratingTxt = (f.overall_rating != null) ? Number(f.overall_rating).toFixed(1) + ' / 5' : '—';\n",
    "    const metaParts = [];\n",
    "    if (f.concentration) metaParts.push(chip(f.concentration, 'meta'));\n",
    "    if (f.tier)          metaParts.push(chip(f.tier, 'meta'));\n",
    "    if (f.launch_year)   metaParts.push(chip('Est. ' + f.launch_year, 'meta'));\n",
    "    if (f.time)          metaParts.push(chip(f.time, timeClass[f.time] || 't-flex'));\n",
    "    const sb = seasonBadges(f.seasons);\n",
    "    if (sb) metaParts.push(sb);\n",
    "\n",
    "    let html = '';\n",
    "    html += '<div class=\"frag-head\">';\n",
    "    html += '<div><div class=\"frag-name\">' + esc(f.name) + '</div><div class=\"frag-maker\">' + esc(f.maker) + '</div></div>';\n",
    "    html += '<div class=\"frag-img-wrap\">';\n",
    "    if (f.fragram) {\n",
    "      html += '<img class=\"frag-img\" src=\"' + esc(f.fragram) + '\" alt=\"' + esc(f.name) + '\" loading=\"lazy\"' +\n",
    "              ' onerror=\"this.style.display=\\'none\\'\"' +\n",
    "              ' data-lightbox=\"' + esc(f.fragram) + '\">';\n",
    "    }\n",
    "    html += '<div class=\"frag-rating\"><div>' + stars(f.overall_rating) + '</div><div class=\"rating-num\">' + ratingTxt + '</div></div>';\n",
    "    html += '</div>';\n",
    "    html += '</div>';\n",
    "\n",
    "    html += '<div class=\"frag-meta\">' + metaParts.join('') + '</div>';\n",
    "\n",
    "    html += '<div class=\"frag-stats\">';\n",
    "    html += '<div class=\"stat\"><span class=\"stat-icon\">⏱️</span><div><strong>' + (f.longevity_hours != null ? f.longevity_hours + ' h' : '—') + '</strong><small>Longevity</small></div></div>';\n",
    "    html += '<div class=\"stat\"><span class=\"stat-icon\">📢</span><div><strong class=\"dots\">' + (dots(f.sillage) || '—') + '</strong><small>Sillage</small></div></div>';\n",
    "    html += '<div class=\"stat\"><span class=\"stat-icon\">🌫️</span><div><strong>' + esc(f.projection || '—') + '</strong><small>Projection</small></div></div>';\n",
    "    html += '</div>';\n",
    "\n",
    "    if (f.notes_raw) html += '<div class=\"frag-note\">' + esc(f.notes_raw) + '</div>';\n",
    "\n",
    "    html += pyramidHTML(f.pyramid);\n",
    "\n",
    "    if (f.perfumer) html += '<div class=\"frag-perfumer\"><span class=\"lbl\">Perfumer</span>' + esc(f.perfumer) + '</div>';\n",
    "\n",
    "    html += '<div class=\"frag-actions\">';\n",
    "    if (f.scraped_url) html += '<a class=\"frag-link\" href=\"' + esc(f.scraped_url) + '\" target=\"_blank\" rel=\"noopener\">View on Fragrantica ↗</a>';\n",
    "    html += '<button class=\"frag-wear\" type=\"button\">✔ Mark as worn today</button>';\n",
    "    html += '</div>';\n",
    "\n",
    "    cardEl.innerHTML = html;\n",
    "    const wearBtn = cardEl.querySelector('.frag-wear');\n",
    "    if (wearBtn) wearBtn.addEventListener('click', markWorn);\n",
    "  }\n",
    "\n",
    "  function renderChips(){\n",
    "    seasonChips.forEach(function(c){\n",
